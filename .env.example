# Supabase — 모든 접근은 Next.js BFF(서버)에서만 이뤄지므로 NEXT_PUBLIC_ 접두사를 쓰지 않는다.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# 이미지가 저장된 Storage 버킷 이름 (place_image.image_path 가 가리키는 버킷)
SUPABASE_STORAGE_BUCKET=place-image

# 프로필 이미지 버킷 (profile.image_path 가 가리키는 버킷)
SUPABASE_PROFILE_IMAGE_BUCKET=profile-image

# 상품 이미지 버킷 (product.image_path_main / image_path_detail 이 가리키는 버킷)
SUPABASE_PRODUCT_IMAGE_BUCKET=product-image

# 공개 오브젝트 주소의 베이스. DB에는 파일 경로만 저장하고 주소는 이 값으로 조립한다.
SUPABASE_STORAGE_URL=https://<project-ref>.supabase.co/storage/v1/object/public

# RLS를 우회하는 서비스 롤 키 — 사용자 세션이 없는 서버 작업에만 쓴다. 절대 클라이언트에 노출 금지.
# 포트원 웹훅의 결제 원장(payment) 기록과 참여자 수 집계에 필요하다. 미설정이면 참여자 수가 0 으로 보인다.
SUPABASE_SERVICE_ROLE_KEY=

# 네이버 지도 (Maps JS API v3) — 장소 등록 화면의 지도 미리보기에 사용.
# 브라우저가 maps.js 스크립트를 직접 로드하므로 클라이언트 키(ncpKeyId)이며, 이 값은 노출돼도 된다.
# (Supabase 와 달리 BFF 로 감출 수 없다. 실제 보안은 네이버 콘솔의 '서비스 URL' 도메인 제한으로 건다.)
# 발급: 네이버 클라우드 플랫폼 콘솔 > Services > Maps > Application 등록 > 인증 정보(Client ID/Key ID).
# 그래서 예외적으로 NEXT_PUBLIC_ 접두사를 쓴다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=your-naver-maps-client-id

# 네이버 지도 REST (리버스 지오코딩) — 좌표→주소 변환(/api/reverse-geocode)에서 서버만 호출한다.
# 위 지도 스크립트와 같은 Maps Application 의 인증 정보지만, REST 호출에는 Client Secret 이 필요하고
# 이 값은 노출되면 안 되므로 NEXT_PUBLIC_ 접두사를 쓰지 않는다.
# 발급: 네이버 클라우드 플랫폼 콘솔 > Services > Maps > Application > 인증 정보(Client Secret).
# 문서: https://api.ncloud-docs.com/docs/en/application-maps-reversegeocoding
NAVER_MAP_CLIENT_SECRET=your-naver-maps-client-secret

# Client ID 는 지도 스크립트(NEXT_PUBLIC_NAVER_MAP_CLIENT_ID)와 같은 값이라 생략해도 된다.
# 지도용과 REST 용 Application 을 따로 쓸 때만 아래 값을 채운다.
# NAVER_MAP_CLIENT_ID=

# 네이버 지역검색 (NCP API Hub) — 장소 검색(/api/place-search)에서 서버만 호출한다.
# 지도 키와 달리 이 값은 노출되면 안 되므로 NEXT_PUBLIC_ 접두사를 쓰지 않는다.
# 발급: 네이버 클라우드 플랫폼 콘솔 > Services > Naver API Hub > Search(지역) 이용 신청 > 인증키(API Key ID / API Key).
# 문서: https://api.ncloud-docs.com/docs/naver-api-hub-search-local
NAVER_SEARCH_CLIENT_ID=your-ncp-api-key-id
NAVER_SEARCH_CLIENT_SECRET=your-ncp-api-key

# 포트원 V2 결제 — 모임 상세(/events/[id])의 결제창 호출에 쓴다. 접근은 src/lib/portone/env.ts 로만.
# 둘 다 비밀값이 아닌 공개 식별자라(포트원 콘솔 > 결제연동 > 연동 정보) 네이버 지도 Client ID 처럼
# 예외적으로 NEXT_PUBLIC_ 접두사를 쓴다. 결제 규칙 SSOT: .claude/rules/payment.md
NEXT_PUBLIC_PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 포트원 V2 API Secret — 웹훅 처리 시 결제 단건조회 재확인에 쓴다. 서버 전용, 절대 NEXT_PUBLIC_ 금지.
# 발급: 포트원 콘솔 > 결제 연동 > 연동 정보 > V2 API Secret. 접근은 src/lib/portone/serverEnv.ts 로만.
PORTONE_API_SECRET=your-portone-v2-api-secret

# 포트원 V2 웹훅 시크릿 — /api/portone/webhook 의 Standard Webhooks 서명 검증에 쓴다. 서버 전용.
# 발급: 포트원 콘솔 > 결제 연동 > 연동 관리 > 결제알림(Webhook) 관리 > 웹훅 시크릿 발급.
PORTONE_WEBHOOK_SECRET=whsec_xxx
